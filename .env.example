# Copy this file to .env and fill it in. NEVER commit .env (it is already in .gitignore).
# On Render, enter these values in the service's Environment tab instead of using a file.

# --- Site ---------------------------------------------------------------------------------
# The public address of your site. It is printed inside every QR code, so change it to your live
# URL (for example https://truemark.onrender.com) before issuing real demo records.
BASE_URL=http://localhost:8000

# Comma-separated emails that become admins when they sign in. Use your own email.
ADMIN_EMAILS=you@example.com

# Set to false to stop new schools registering (existing accounts keep working).
ALLOW_SIGNUP=true

# --- Database and sign-in: Supabase -------------------------------------------------------
# Leave these three empty to run on temporary in-memory storage (good for a first local try).
# Where to find them: see docs/SETUP_GUIDE.md, steps 1 to 3.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret. Never put this in front-end code, a screenshot, or a public chat.
SUPABASE_SECRET_KEY=

# --- Ledger -------------------------------------------------------------------------------
# mock = fingerprints kept in your database, labelled "simulated" everywhere (works with no setup)
# evm  = fingerprints written to a real blockchain testnet (needs the five values below)
CHAIN_MODE=mock

# Polygon Amoy testnet (defaults). For Sepolia use: CHAIN_NAME=Sepolia testnet, CHAIN_ID=11155111,
# EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/, EXPLORER_ADDRESS_URL=https://sepolia.etherscan.io/address/
CHAIN_NAME=Polygon Amoy testnet
CHAIN_ID=80002
EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/
EXPLORER_ADDRESS_URL=https://amoy.polygonscan.com/address/

# A free RPC address for that network (see docs/SETUP_GUIDE.md, step 5).
RPC_URL=
# Printed by `python scripts/deploy_contract.py` (step 6).
CONTRACT_ADDRESS=
# Private key of a THROWAWAY testnet wallet made with `python scripts/new_wallet.py`.
# Never reuse a wallet that holds real money.
ISSUER_PRIVATE_KEY=

# --- Local demo only ----------------------------------------------------------------------
# Creates sample schools and records on in-memory storage. Ignored when Supabase is configured.
DEV_SEED=false
